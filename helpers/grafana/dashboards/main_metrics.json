      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "pieType": "pie",
        "displayLabels": ["percent", "name"]
      },
      "targets": [
        {
          "expr": "sum(increase(cinema_http_requests_total{method=~\"$method\", path=~\"$path\"}[$__range])) by (status)",
          "legendFormat": "Status {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP status distribution",
      "type": "piechart"
