{
  "uid": "cinema-business-metrics",
  "title": "Cinema Business Metrics Dashboard",
  "tags": ["cinema", "business", "prometheus", "go", "metrics"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "method",
        "type": "query",
        "label": "HTTP Method",
        "query": "label_values(cinema_http_requests_total, method)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "path",
        "type": "query",
        "label": "Endpoint",
        "query": "label_values(cinema_http_requests_total{method=~\"$method\"}, path)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "status",
        "type": "query",
        "label": "Status Code",
        "query": "label_values(cinema_http_requests_total{method=~\"$method\", path=~\"$path\"}, status)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "HTTP metrics",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (method, path) (rate(cinema_http_requests_total{method=~\"$method\", path=~\"$path\", status=~\"$status\"}[5m]))",
          "legendFormat": "{{method}} {{path}}",
          "refId": "A"
        }
      ],
      "title": "HTTP requests rate (requests/sec)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cinema_http_request_duration_seconds_bucket{method=~\"$method\", path=~\"$path\", status=~\"$status\"}[5m])) by (le, method, path))",
          "legendFormat": "{{method}} {{path}} (P95)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(cinema_http_request_duration_seconds_bucket{method=~\"$method\", path=~\"$path\", status=~\"$status\"}[5m])) by (le, method, path))",
          "legendFormat": "{{method}} {{path}} (P99)",
          "refId": "B"
        }
      ],
      "title": "HTTP request duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(cinema_http_requests_total{method=~\"$method\", path=~\"$path\"}[5m]))",
          "legendFormat": "Status {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP requests by status code",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
