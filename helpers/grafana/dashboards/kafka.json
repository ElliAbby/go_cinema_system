{
  "uid": "kafka-metrics",
  "title": "Kafka Integration Metrics",
  "tags": ["kafka", "integration", "go", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "query",
        "label": "Service",
        "query": "label_values(kafka_messages_received_total, app)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "env",
        "type": "query",
        "label": "Environment",
        "query": "label_values(kafka_messages_received_total{app=~\"$app\"}, env)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "instance",
        "type": "query",
        "label": "Instance",
        "query": "label_values(kafka_messages_received_total{app=~\"$app\", env=~\"$env\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      },
      {
        "name": "topic",
        "type": "query",
        "label": "Topic",
        "query": "label_values(kafka_messages_received_total{app=~\"$app\", env=~\"$env\", instance=~\"$instance\"}, topic)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Kafka Consumer metrics",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_messages_received_total{app=~\"$app\", env=~\"$env\", instance=~\"$instance\", topic=~\"$topic\"}[5m]))",
          "legendFormat": "{{topic}} received",
          "refId": "A"
        },
        {
          "expr": "sum by (topic) (rate(kafka_messages_processed_total{app=~\"$app\", env=~\"$env\", instance=~\"$instance\", topic=~\"$topic\"}[5m]))",
          "legendFormat": "{{topic}} processed",
          "refId": "B"
        }
      ],
      "title": "Message throughput (consumer)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_messages_failed_total{app=~\"$app\", env=~\"$env\", instance=~\"$instance\", topic=~\"$topic\"}[5m]))",
          "legendFormat": "{{topic}} failed",
          "refId": "A"
        },
        {
          "expr": "sum by (topic) (rate(kafka_message_retries_total{app=~\"$app\", env=~\"$env\", instance=~\"$instance\", topic=~\"$topic\"}[5m]))",
          "legendFormat": "{{topic}} retries",
          "refId": "B"
        },
        {
          "expr": "sum by (topic) (rate(kafka_consumer_errors_total{app=~\"$app\", env=~\"$env\", instance=~\"$instance\", topic=~\"$topic\"}[5m]))",
          "legendFormat": "{{topic}} consumer errors",
          "refId": "C"
        }
      ],
      "title": "Consumer errors and retries",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_message_processing_duration_seconds_sum{app=~\"$app\", env=~\"$env\", instance=~\"$instance\", topic=~\"$topic\"}[5m])) / sum by (topic) (rate(kafka_message_processing_duration_seconds_count{app=~\"$app\", env=~\"$env\", instance=~\"$instance\", topic=~\"$topic\"}[5m]))",
          "legendFormat": "{{topic}} avg",
          "refId": "A"
        }
      ],
      "title": "Average processing duration",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(kafka_message_processing_duration_seconds_bucket{app=~\"$app\", env=~\"$env\", instance=~\"$instance\", topic=~\"$topic\"}[5m])) by (le))",
          "legendFormat": "{{topic}} p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(kafka_message_processing_duration_seconds_bucket{app=~\"$app\", env=~\"$env\", instance=~\"$instance\", topic=~\"$topic\"}[5m])) by (le))",
          "legendFormat": "{{topic}} p99",
          "refId": "B"
        }
      ],
      "title": "Processing duration percentiles",
      "type": "timeseries"
    },
